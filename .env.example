# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================

# Node.js
NODE_ENV=production
PORT=3000

# Database (MySQL 8.0+)
DATABASE_URL=mysql://suppley:SuppleyDb2024@localhost:3306/suppley_calc

# JWT Authentication
JWT_SECRET=seu-jwt-secret-super-secreto-aqui-min-32-chars

# IA Integration (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-xxx

# Inteligência de mercado (OPCIONAIS — sem elas o app usa só BCB/IBGE/web)
# FRED (commodities globais): chave grátis em https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# UN Comtrade (preço global por HS): chave grátis em https://comtradeapi.un.org
COMTRADE_API_KEY=

# Frontend (Vite)
VITE_APP_ID=suppley-app
VITE_OAUTH_PORTAL_URL=  # Deixar vazio se não usar OAuth

# OAuth (opcional)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Legacy (deprecated - manter por compatibilidade)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ============================================================
# Docker Production
# ============================================================
# Quando usar docker-compose.yml:
DB_ROOT_PASSWORD=root
DB_PASSWORD=SuppleyDb2024

# ============================================================
# TTCE — Portal Único Siscomex (tratamento tributário oficial)
# ============================================================
# Fonte oficial de ex-tarifário/GECEX e preferências por NCM+país.
# Ative SOMENTE depois do smoke test no servidor:
#   npx tsx scripts/ttceSmoke.ts 84798999 China
TTCE_ENABLED=false
# TTCE_BASE_URL=https://portalunico.siscomex.gov.br

# ============================================================
# Cotação semi-automatizada (RFQ → fornecedores por email)
# ============================================================
# Provedor de SAÍDA (emailService): SendGrid ou Mailgun HTTP.
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS=rfq@suppley.com.br
# EMAIL_FROM_NAME=SUPPLEY
# Webhook de ENTRADA (respostas dos fornecedores) em POST /api/rfq/inbound.
# Sem o token, o endpoint fica desabilitado (404).
# RFQ_INBOUND_TOKEN=

# URL pública da aplicação (sem barra final). Usada para montar links
# ABSOLUTOS de arquivo — necessários quando o link sai por email.
# Vazia, os links saem relativos e funcionam dentro do chat.
APP_URL=https://calculasuppley.com.br
