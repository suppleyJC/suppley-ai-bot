# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/suppley_calc

# For PlanetScale:
# DATABASE_URL=mysql://username:password@aws.connect.psdb.cloud/database_name?sslaccept=strict

# For Supabase (PostgreSQL):
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

DATABASE_URL=mysql://root:password@localhost:3306/suppley_calc

# ============================================
# SECURITY
# ============================================
# CRITICAL: Change this to a strong random string in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# OAUTH CONFIGURATION (Optional)
# ============================================
# Only required if you want to maintain compatibility with Manus OAuth
# Leave empty to use JWT-based authentication only
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ============================================
# RUNTIME & DEPLOYMENT
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================
# Forge API (if using external integrations)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Analytics (if tracking usage)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
