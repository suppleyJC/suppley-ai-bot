# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env and fill with real values before deploying

# ============================================
# DATABASE (Production)
# ============================================
# Using PlanetScale (Recommended):
DATABASE_URL=mysql://user:password@aws.connect.psdb.cloud/suppley_calc?sslaccept=strict

# Or self-managed MySQL on private network:
# DATABASE_URL=mysql://suppley:secure_password@db.internal:3306/suppley_calc

# ============================================
# SECURITY (CRITICAL!)
# ============================================
# Generate with: openssl rand -base64 32
# NEVER use the development secret in production!
JWT_SECRET=your-production-jwt-secret-here-change-this

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# STORAGE — AWS S3 (OBRIGATÓRIO)
# ============================================
# Sem estas variáveis, todo upload falha com
# "S3 upload failed: AWS_S3_BUCKET environment variable not configured".
# Não há fallback local: o S3 é o único backend de arquivos (proformas, PDFs).
# Passo a passo de criação do bucket e do usuário IAM: docs/AWS_S3_SETUP.md
AWS_S3_BUCKET=suppley-ai-uploads-prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================
# OAUTH (Optional - Only if maintaining Manus compatibility)
# ============================================
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# ============================================
# INTEGRATIONS (Optional)
# ============================================
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ============================================
# ANALYTICS (Optional)
# ============================================
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ============================================
# DOCKER COMPOSE (if using docker-compose.yml)
# ============================================
DB_ROOT_PASSWORD=secure-root-password
DB_USER=suppley
DB_PASSWORD=secure-app-password
DB_NAME=suppley_calc
